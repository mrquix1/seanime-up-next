{
    "version": "0.4.0",
    "id": "up-next",
    "name": "Up Next",
    "description": "Shows the next few episodes of each show you're currently watching, plus a hero banner, a latest episodes row and resume progress on the home screen",
    "manifestURI": "https://raw.githubusercontent.com/mrquix1/seanime-up-next/main/up-next.json",
    "language": "javascript",
    "type": "plugin",
    "author": "mrquix1",
    "payloadURI": "https://raw.githubusercontent.com/mrquix1/seanime-up-next/main/up-next.js",
    "plugin": {
        "version": "1",
        "permissions": {
            "scopes": [
                "anilist"
            ],
            "allow": {
                "networkAccess": {
                    "allowedDomains": [
                        "api.ani.zip",
                        "graphql.anilist.co"
                    ]
                }
            }
        }
    }
}
